# Salin file ini menjadi `.env.local`, lalu isi nilainya.
#   cp .env.example .env.local
# `.env.local` sudah masuk .gitignore. Jangan pernah commit API key asli.
# Setelah mengubah .env.local, restart `npm run dev`.

# API key dari Resend (https://resend.com/api-keys). Wajib.
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Alamat email owner yang menerima pesan dari Contact Form. Opsional.
# Jika dikosongkan, dipakai `site.email` dari data/site.ts (fireflieswebsite@gmail.com).
#
# CATATAN: selama memakai sender default `onboarding@resend.dev`, Resend HANYA mengizinkan
# pengiriman ke email yang dipakai untuk mendaftar akun Resend. Karena itu, daftarkan
# akun Resend dengan fireflieswebsite@gmail.com.
CONTACT_TO_EMAIL=fireflieswebsite@gmail.com

# Alamat pengirim. Opsional.
# Default: "Fireflies Website <onboarding@resend.dev>" (tanpa perlu verifikasi domain).
# Jika nanti sudah punya domain yang diverifikasi di Resend (https://resend.com/domains),
# ganti, misalnya: "Fireflies Website <contact@domainanda.com>"
# CONTACT_FROM_EMAIL=Fireflies Website <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------

# URL PUBLIK website (WAJIB diisi di hosting/production), tanpa garis miring di akhir.
# Dipakai untuk canonical, sitemap.xml, robots.txt, Open Graph, dan structured data.
# Jika kosong, di Vercel otomatis memakai domain produksi Vercel; di luar itu memakai localhost.
# Contoh: https://domainanda.com
NEXT_PUBLIC_SITE_URL=

# Kode verifikasi Google Search Console (opsional, metode "HTML tag").
# Hanya isi nilai content-nya saja (bukan seluruh tag <meta>).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
